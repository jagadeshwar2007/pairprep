# ---------------------------------------------------------------------------
# Pairprep environment variables. Copy to .env.local and fill in real values.
# NEVER commit .env.local. Only the first three NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Supabase project URL (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase "anon" / publishable key (Dashboard > Project Settings > API Keys).
# Safe to expose: it only grants what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public origin of this deployment, used to build the Google OAuth redirect.
# Local: http://localhost:3000   Production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-SIDE ONLY. Bypasses Row Level Security, so it must never be exposed to the
# browser, committed, or prefixed with NEXT_PUBLIC_. Used only for: validating uploaded
# files, copying approved files to published storage, suspending users at the Auth layer,
# the retention job and scripts/bootstrap-super-admin.mjs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret that protects /api/cron/cleanup (Vercel Cron sends it as a Bearer token).
# Generate one with: openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string
