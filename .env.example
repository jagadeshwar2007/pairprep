# Copy to .env.local and fill in. Never commit real values (.env* is git-ignored).

# --- Firebase web app config (public; safe in the browser) -------------------------
# Firebase console -> Project settings -> Your apps -> Web app -> SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only) ---------------------------------------------------
# Service-account JSON from Project settings -> Service accounts -> Generate new private key.
# Paste the JSON on one line, or base64-encode it:  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=

# --- Google Drive (server only; pick one) -------------------------------------------
# Recommended: an API key restricted to the Google Drive API. It can read metadata for
# files shared "Anyone with the link", which is also what students need to open them.
GOOGLE_DRIVE_API_KEY=
# Alternative: a service-account JSON (raw or base64) for folders shared with that account.
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=

# --- Local development with the Firebase emulators (optional) -----------------------
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
