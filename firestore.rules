rules_version = '2';

// PairPrep Firestore security rules.
//
// All writes go through the Next.js API, which uses the Firebase Admin SDK (Admin SDK
// requests bypass these rules) and performs every authorization check on the server.
// These rules therefore:
//   * deny every client-side write, so roles, statuses and approvals can never be
//     changed from a browser or a modified request; and
//   * allow only the minimum client reads: public catalogue entries, a user's own
//     profile/submissions, a reviewer's own assignments, and everything for admins.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Published, approved resources are public. Contributors can read their own submissions.
    match /resources/{resourceId} {
      allow read: if (resource.data.publicationStatus == 'published'
                      && resource.data.verificationStatus == 'approved')
                  || (signedIn() && resource.data.uploadedBy == request.auth.uid)
                  || isAdmin();
      allow write: if false;
    }

    // Profiles: a user can read their own; admins can read all. Nobody writes from a client,
    // so a role can never be self-assigned.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    // Reviewers can read only the assignments addressed to them.
    match /reviewAssignments/{assignmentId} {
      allow read: if (signedIn() && resource.data.reviewerUid == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // Internal de-duplication index: server only.
    match /driveFileIndex/{fileId} {
      allow read, write: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
